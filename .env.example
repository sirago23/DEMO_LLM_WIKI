# Copy this file to .env and fill in real values. .env is gitignored.

# Anthropic (used locally by Claude Code for ingest/lint tasks)
ANTHROPIC_API_KEY=your_anthropic_key_here

# GitHub (only needed if repo becomes private)
GITHUB_TOKEN=your_github_pat_here

# LINE Messaging API (for local testing scripts if needed)
LINE_CHANNEL_TOKEN=your_line_channel_access_token_here
